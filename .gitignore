npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- Test / coverage ----
coverage/
.nyc_output/

# ---- Local database volumes ----
pgdata/
