# Usually nothing to set here.
#
# The app calls the API at /api on its own origin. In development Vite
# forwards /api to http://localhost:4000 (run with API_ORIGIN=... to use
# another address); in production Vercel forwards it (see vercel.json).
# One origin keeps the sign-in cookie first-party, which Safari requires.
#
# Set VITE_API_URL only to call an API on a different origin directly; the
# API then needs COOKIE_SAMESITE=none. Vite exposes VITE_ variables to the
# browser, so never put secrets in this file.
# VITE_API_URL=http://localhost:4000
