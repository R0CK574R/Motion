# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Public URL of the FRONTEND. Used for CORS and Stripe redirect URLs.
# Production example: https://main.d1234abcd.amplifyapp.com
APP_URL=http://localhost:5173

# Postgres connection string.
# Local (docker compose): postgres://motion:motion@postgres:5432/motion
# RDS: postgres://USER:PASSWORD@your-db.abc123.us-west-1.rds.amazonaws.com:5432/motion
DATABASE_URL=
# RDS requires SSL — set to "true" in production. Local Docker Postgres does not.
PGSSL=false

# --- Production-only settings (leave blank/unset locally) ---

# Number of proxy hops to trust. Set to 1 behind App Runner, an ALB, or
# CloudFront so Express correctly detects HTTPS. Leave unset locally.
TRUST_PROXY=

# Set to "none" ONLY if the frontend and API are on different registrable
# domains — e.g. …amplifyapp.com talking to …awsapprunner.com. Without this the
# browser silently drops the refresh cookie and sessions die on page reload.
# If you put both behind one domain (app.motion.com + api.motion.com), leave
# this blank to keep the stricter "lax" default.
# SameSite=None also forces Secure, which requires HTTPS.
COOKIE_SAMESITE=

# --- Secrets ---

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Server-side only. Never exposed to the frontend — that's the whole point.
ANTHROPIC_API_KEY=

# Stripe (test keys start with sk_test_ / whsec_; live keys with sk_live_)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
