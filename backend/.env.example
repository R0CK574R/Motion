# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Frontend origin — used for CORS and for Stripe redirect URLs.
APP_URL=http://localhost:5173

# Postgres connection string, e.g.
# postgres://motion:motion@localhost:5432/motion
DATABASE_URL=
# Set to "true" only if your Postgres provider requires SSL (most managed
# providers like RDS do; local Docker Postgres does not).
PGSSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Server-side only. Never exposed to the frontend — that's the whole point.
ANTHROPIC_API_KEY=

# Stripe (test mode keys start with sk_test_ / pk_test_ / whsec_)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
