# Copy this file to .env and fill in real values. Never commit .env.

# "production" turns on Secure cookies. Anything else is treated as development.
APP_ENV=development
PORT=4000

# Public URL of the FRONTEND. Used for CORS and Stripe redirect URLs.
# Production example: https://motion.vercel.app
APP_URL=http://localhost:5173

# Postgres connection string, in the form hosting providers give you.
# Local (docker compose sets this for you): postgres://motion:motion@postgres:5432/motion
# Neon: postgres://USER:PASSWORD@ep-xxxx.us-west-2.aws.neon.tech/motion?sslmode=require
DATABASE_URL=
# Set to "true" to require TLS when the URL does not already say sslmode=.
PGSSL=false

# Base URL of the C++ risk engine service (see risk-engine/). docker compose
# sets this for you. If it is unset, /api/risk answers 503 and the dashboard
# shows the risk section as offline; everything else keeps working.
RISK_ENGINE_URL=http://localhost:8000

# --- Production-only settings (leave blank locally) ---

# Set to "native" when the API runs behind a proxy or load balancer that
# terminates TLS (Render, App Runner, an ALB). It makes the server trust the
# X-Forwarded-* headers, so it sees the real client IP and that the request
# was HTTPS. Leave unset locally.
# SERVER_FORWARD_HEADERS_STRATEGY=native

# Set to "none" ONLY if the frontend and API are on different registrable
# domains, for example something.vercel.app talking to something.onrender.com.
# Without it the browser silently drops the refresh cookie and sessions die on
# page reload. If both sit under one domain (app.example.com and
# api.example.com), leave this blank to keep the stricter "lax" default.
# SameSite=None also forces Secure, which requires HTTPS.
COOKIE_SAMESITE=

# --- Secrets ---

# At least 32 characters. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=

# Your Anthropic API key (starts with sk-ant-). Server-side only: it is sent
# to api.anthropic.com as a request header and nowhere else. It is never
# logged, stored in the database or sent to the browser.
# Keep it ONLY in this file's untracked copy (backend/.env), in your hosting
# provider's environment settings, and as a GitHub Actions secret. Never paste
# it into code, a commit, an issue or a chat.
ANTHROPIC_API_KEY=

# --- AI settings (not secret) ---

# Which Claude model answers. The default is the cheapest current one.
ANTHROPIC_MODEL=claude-haiku-5-5
# AI requests one signed-in user may make per day.
AI_DAILY_LIMIT_PER_USER=50
# AI requests ALL demo visitors together may make per day. At 0, demo accounts
# never reach the model and get sample answers instead, so strangers cannot
# spend your credits. Raise it only if you want the public demo to use the
# real model, and treat the number as your daily spending cap.
AI_DEMO_DAILY_LIMIT=0

# Stripe (test keys start with sk_test_ / whsec_; live keys with sk_live_)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
